@native fun printf(format: string, ...) -> i32;

entity Lol {
  i32 something;
};

entity @public Hello {
  Lol lol;
};

fun i32::lol(self: i32) {
  return self + 15;
}

fun @public main() {
  //@public(lol = true) i32 age = 5;

  //printf("asd %f\n", 5.4);
  //printf("g %d\n", (9).lol().lol());

  Lol g = Lol { something = 9 };
  Hello h = Hello { lol = g };
  printf("lol %d\n", h.lol.something);
}
