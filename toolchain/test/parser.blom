@native fun printf(format: string, ...) -> i32;

entity @public Hello {
  i32 lol;
};

fun i32::lol(self: i32) {
  return self + 15;
}

fun @public main() {
  @public(lol = true) i32 age = 5;

  printf("asd %f\n", 5.4);
  printf("g %d\n", (9).lol().lol());
  printf("f %d\n", ((Hello {lol = 5}).lol).lol());

  Hello h = Hello { lol = 5 };
  printf("lol %d\n", h.lol);
}
