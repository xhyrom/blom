fun @native printf(format: string, ...) -> i32;

entity Person {
  i32 age;
}

fun Person::new(age: i32) -> Person {
  return Person {
    age = age
  };
}

fun @public main() -> i32 {
  Person p1 = Person::new(420);
  Person* p2 = &p1;
  (*p2).age = 985;

  printf("age p1: %d\n", p1.age);
  printf("age p2: %d\n", (*p2).age);
}
