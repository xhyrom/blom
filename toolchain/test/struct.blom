fun @native printf(format: string, ...) -> i32;

entity Person {
  string name;
  i32 age;
}

fun Person::new(name: string, age: i32) -> Person {
  return Person {
    name = name,
    age = age
  };
}

fun Person::extend(self: Person) {
  printf("extended");
}

fun @public main() -> i32 {
  Person p1 = Person::new("John Doe", 42);
  printf("a");
  p1.extend()

  return 0;
}
