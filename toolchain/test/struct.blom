fun @native printf(format: string, ...) -> i32;

entity Person {
  i32 age;
  i32 height;
  string name;
}

fun Person::new(age: i32, height: i32, name: string) -> Person {
  return Person {
    age = age,
    height = height,
    name = name
  };
}

fun Person::asd(self: Person*) {
  (*self).age = (*self).age + 1;
  (*self).height = (*self).height + 1;
  (*self).name = "hylík";
}

fun Person::gum(self: Person*, age: i32) {
  (*self).age = age;
}

fun @public main() -> i32 {
  Person p = Person::new(420, 55, "initial");;

  printf("age: %d\nheight: %d\nname: %s\n", p.age, p.height, p.name);

  printf("\n");
  p.asd()
  p.gum(69)

  printf("age: %d\nheight: %d\nname: %s\n", p.age, p.height, p.name);
}
