@native fun printf(format: string, ...) -> i32;

fun fact(n: i32) -> i32 {
    if n == 0 {
        return 1;
    } else {
        return n * fact(n - 1);
    }

    return 0;
}

fun fib(n: i32) -> i32 {
    if n == 0 {
        return 0;
    } else {
        if n == 1 {
            return 1;
        } else {
            return fib(n - 1) + fib(n - 2);
        }
    }

    return 0;
}

fun @public main() -> i32 {
  printf("%d\n", fib(45));
  return 0;
}
