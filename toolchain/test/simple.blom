fun @native @variadic printf(format: string);

fun test(a: i32) {
  printf("hello %d\n", 5);
  return 0;
}

fun test(a: i32, b: i32) {
  return a + b;
}

fun something::i32::test(a: string) -> string {
    return a;
}

fun @public main() {
  printf("hello %d %d %s\n", test(5), test(5, 7), something::i32::test("ahoj"));
  return 0;
}
